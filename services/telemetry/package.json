{
  "name": "@zeroclave/telemetry-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "check": "tsc --noEmit",
    "dev": "wrangler dev",
    "migrate:local": "wrangler d1 migrations apply zeroclave_telemetry --local",
    "migrate:remote": "wrangler d1 migrations apply zeroclave_telemetry --remote",
    "test": "node --test tests/*.test.ts",
    "types": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260917.1",
    "@types/node": "^25.6.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.85.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
