{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zeroclave-telemetry",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-18",
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "dependencies_instrumentation": {
    "enabled": false
  },
  "minify": true,
  "observability": {
    "enabled": false,
    "logs": {
      "invocation_logs": false
    }
  },
  "triggers": {
    "crons": ["15 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zeroclave_telemetry",
      "migrations_dir": "migrations"
    }
  ]
}
