{
  "name": "@zeroclave/dsh-privacy",
  "version": "0.1.0-alpha.16",
  "description": "ZeroClave privacy firewall for DeepSeek Harness",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "test": "cd ../../.. && vitest run packages/experimental/zeroclave-privacy/tests"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "lucide": "1.8.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-locale": "^0.1.1-rc.2 || ^0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.1-rc.2 || ^0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-layout": "^0.1.1-rc.2 || ^0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.1-rc.2 || ^0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.1-rc.2 || ^0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.1-rc.2 || ^0.1.3-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.3-alpha.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@huggingface/transformers": "3.8.1",
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-locale": "^0.1.1-rc.2 || ^0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.1-rc.2 || ^0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-layout": "^0.1.1-rc.2 || ^0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.1-rc.2 || ^0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.1-rc.2 || ^0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.1-rc.2 || ^0.1.3-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.3-alpha.1",
    "@deepseek-ai/dsh-util-crypto": "0.1.3-alpha.1",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.7",
    "jsdom": "29.1.1",
    "playwright": "1.61.1",
    "react": "^18.2.0",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "files": [
    "cordis.patch.yml",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
